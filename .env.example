DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/netflix_intelligence

# Read-only role used by the copilot (Step 3). Do not use the admin password here.
COPILOT_RO_PASSWORD=choose-a-readonly-password
COPILOT_DB_URL=postgresql://copilot_ro:choose-a-readonly-password@localhost:5432/netflix_intelligence

# LLM for Week 3. Put the real Gemini key only in .env, never in git.
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash
